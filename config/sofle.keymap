#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>

&pinctrl {
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 0, 22)>; /* <<<--- different pin here */
		};
	};
	
	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 0, 22)>; /* <<<--- different pin here */
			low-power-enable;
		};
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	
	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		
		/* SPI */
		reg = <0>; /* ignored, but necessary for SPI bindings */
		spi-max-frequency = <4000000>;
		
		/* WS2812 */
		chain-length = <7>; /* <<<--- different number of LEDs here */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		
		color-mapping = <
		LED_COLOR_ID_GREEN
		LED_COLOR_ID_RED
		LED_COLOR_ID_BLUE
		>;
	};
};

// Part No. EC11N1525404
&sensors {
	triggers-per-rotation = <15>;
};

&left_encoder {
	steps = <30>;
};

&right_encoder {
	steps = <30>;
};

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
	chosen {
		zmk,underglow = &led_strip;
	};
	
	// Activate ADJUST layer by holding raise and lower
	conditional_layers {
		compatible = "zmk,conditional-layers";
		adjust_layer {
			if-layers = <LOWER RAISE>;
			then-layer = <ADJUST>;
		};
	};
	
	behaviors {
		// Hold = momentary layer, tap = toggle layer on/off.
		// hold-preferred so the layer engages the instant you press
		// another key, without waiting out the tapping term.
		lt_tog: layer_hold_toggle {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			bindings = <&mo>, <&tog>;
		};
		
		// Encoder rotation driving mouse scroll instead of keypresses.
		scroll_enc: sensor_rotate_scroll {
			compatible = "zmk,behavior-sensor-rotate-var";
			#sensor-binding-cells = <2>;
			bindings = <&msc>, <&msc>;
			tap-ms = <20>;
		};
		
		// Encoder rotation driving underglow settings.
		rgb_bri_enc: sensor_rotate_rgb_brightness {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
		};
		
		rgb_hue_enc: sensor_rotate_rgb_hue {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;
		};
	};
	
	macros {
		clip: clipboard_history {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <40>;
			tap-ms = <40>;
			bindings
			= <&kp LG(SPACE)>
			, <&macro_wait_time 250>
			, <&kp LG(N4)>;
		};
	};
	
	keymap {
		compatible = "zmk,keymap";
		
		default_layer {
			display-name = "default";
			// ---------------------------------------------------------------------------------------------------------
			// |   `   |  1  |  2  |  3  |  4  |  5  |                    |  6  |  7  |  8  |  9  |   0   |   -   |
			// |  ESC  |  Q  |  W  |  E  |  R  |  T  |                    |  Y  |  U  |  I  |  O  |   P   | BKSPC |
			// |  TAB  |  A  |  S  |  D  |  F  |  G  |                    |  H  |  J  |  K  |  L  |   ;   |   '   |
			// | SHIFT |  Z  |  X  |  C  |  V  |  B  | F13  |  | F14  |  N  |  M  |  ,  |  .  |   /   | SHIFT |
			//               | CTRL | ALT | GUI | LOWER | SPACE |  | ENTER | RAISE | RGUI | RALT | RCTRL |
			//
			// Encoder buttons: F13 (Mission Control)  |  F14 (App Expose)
			// Encoders: LEFT = RIGHT / LEFT arrow     RIGHT = DOWN / UP arrow
			bindings = <
			&kp GRAVE &kp N1     &kp N2   &kp N3   &kp N4    &kp N5                              &kp N6              &kp N7    &kp N8    &kp N9   &kp N0    &kp MINUS
			&kp ESC   &kp Q      &kp W    &kp E    &kp R     &kp T                               &kp Y               &kp U     &kp I     &kp O    &kp P     &kp BSPC
			&kp TAB   &kp A      &kp S    &kp D    &kp F     &kp G                               &kp H               &kp J     &kp K     &kp L    &kp SEMI  &kp SQT
			&kp LSHFT &kp Z      &kp X    &kp C    &kp V     &kp B     &kp F13         &kp F14   &kp N               &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
			&kp LCTRL &kp LALT &kp LGUI &lt_tog LOWER LOWER &kp SPACE  &kp RET &lt_tog RAISE RAISE &kp RGUI &kp RALT  &kp RCTRL
			>;
			
			sensor-bindings = <&inc_dec_kp RIGHT LEFT &inc_dec_kp DOWN UP>;
		};
		
		lower_layer {
			display-name = "lower";
			// Theme: numbers, symbols, F-keys, media.
			// F-keys sit above their matching number: 1=F1 ... 0=F10, F11 on `-`, F12 on grave.
			// Left block is paired symbols. Index columns hold the three bracket pairs.
			// ---------------------------------------------------------------------------------------------------------
			// |  F12  |  F1 |  F2 |  F3 |  F4 |  F5 |                      |  F6 |  F7 |  F8 |  F9 |  F10  |  F11  |
			// |       |  ~  |  <  |  >  |  (  |  )  |                      | KP7 | KP8 | KP9 | KP0 |   =   |       |
			// |       |  _  |  :  |  =  |  [  |  ]  |                      | KP4 | KP5 | KP6 | KP+ |  KP-  |  KP.  |
			// |       |  \  |  &  |  |  |  {  |  }  | MUTE |  | PLAY  | KP1 | KP2 | KP3 | KP* |  KP/  |       |
			//               |     |     |     |     |      |  |       |     |     |     |     |
			//
			// Encoder buttons: MUTE  |  PLAY / PAUSE
			// Encoders: LEFT = VOL UP / DOWN          RIGHT = BRIGHTNESS UP / DOWN
			bindings = <
			&kp F12   &kp F1     &kp F2    &kp F3    &kp F4    &kp F5                              &kp F6    &kp F7    &kp F8    &kp F9          &kp F10       &kp F11
			&trans    &kp TILDE  &kp LT    &kp GT    &kp LPAR  &kp RPAR                            &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_N0       &kp EQUAL     &trans
			&trans    &kp UNDER  &kp COLON &kp EQUAL &kp LBKT  &kp RBKT                            &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS     &kp KP_MINUS  &kp KP_DOT
			&trans    &kp BSLH   &kp AMPS  &kp PIPE  &kp LBRC  &kp RBRC  &kp C_MUTE      &kp C_PP  &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_MULTIPLY &kp KP_DIVIDE &trans
			&trans    &trans    &trans    &trans    &trans      &trans &trans &trans    &trans    &trans
			>;
			
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DEC>;
		};
		
		raise_layer {
			display-name = "raise";
			// Theme: getting around. Left hand = macOS, VSCode, Jupyter, clipboard.
			// Right hand = three tiers of movement: OPTION (word), plain (char), COMMAND (line/doc).
			// ---------------------------------------------------------------------------------------------------------
			// |     | SNIP    | SNIPMENU  | EMOJI   | WINCYC  | APPSW   |                       | ZOOM- | ZOOM0 | ZOOM+ |       |       | DEL |
			// |     | PALETTE | QUICKOPEN | FINDALL | TERM    | SIDEBAR |                       | PGUP  | WRD<- |   ^   | WRD-> | DELWRD| DEL |
			// |     | RUNCELL | RUN+NEXT  | RUN+NEW | COMMENT | CAPSWRD |                       | PGDN  |   <-  |   v   |  ->   | BKSPC |     |
			// |     | UNDO    | CUT       | COPY    | PASTE   | REDO    | CLIP |  | SPOTLGHT    |  DOC^ | LINE< | DOCv  | LINE> | DELLN |     |
			//             |           |         |         |         |      |  |          |       |       |       |       |
			//
			// Encoder buttons: CLIPBOARD HISTORY  |  SPOTLIGHT
			// Encoders: LEFT = SCROLL RIGHT / LEFT    RIGHT = SCROLL DOWN / UP
			bindings = <
			&trans &kp LG(LS(N4)) &kp LG(LS(N5)) &kp LC(LG(SPACE)) &kp LG(GRAVE) &kp LG(TAB)                  &kp LG(MINUS) &kp LG(N0)   &kp LG(EQUAL) &kp LG(LS(LBKT)) &kp LG(LS(RBKT)) &kp LG(W)
			&trans &kp LG(LS(P))  &kp LG(P)      &kp LG(LS(F))     &kp LC(GRAVE) &kp LG(B)                    &kp PG_UP     &kp LA(LEFT) &kp UP        &kp LA(RIGHT)    &kp LA(BSPC)     &kp DEL
			&trans &kp LC(RET)    &kp LS(RET)    &kp LA(RET)       &kp LG(FSLH)  &caps_word                   &kp PG_DN     &kp LEFT     &kp DOWN      &kp RIGHT        &kp BSPC         &trans
			&trans &kp LG(Z)      &kp LG(X)      &kp LG(C)         &kp LG(V)     &kp LG(LS(Z)) &clip  &kp LG(SPACE) &kp LG(UP) &kp LG(LEFT) &kp LG(DOWN) &kp LG(RIGHT)  &kp LG(BSPC)     &trans
			&trans         &trans            &trans        &trans        &trans &trans &trans        &trans       &trans        &trans
			>;
			
			sensor-bindings = <&scroll_enc SCRL_RIGHT SCRL_LEFT &scroll_enc SCRL_DOWN SCRL_UP>;
		};
		
		adjust_layer {
			display-name = "adjust";
			// Theme: settings only. Left half = underglow and firmware. Right half = connectivity.
			// ---------------------------------------------------------------------------------------------------------
			// | BTCLR   | BT1     | BT2     | BT3     | BT4     | BT5     |                     |     |     |      |  |  | BTCLRALL |
			// | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF | RGB_EFR |                     | USB | BLE | OUT> |  |  |          |
			// | STUDIO  | RGB_BRD | RGB_BRI | RGB_ON  | RGB_OFF |         |                     |     |     |      |  |  |          |
			// | BOOTLD  |         |         |         |         |         | RGBTOG |  | EXTPWR |     |     |      |  |  |  RESET   |
			//                     |         |         |         |         |        |  |        |     |     |      |  |
			//
			// Encoder buttons: RGB ON / OFF  |  EXTERNAL POWER TOGGLE
			// Encoders: LEFT = RGB BRIGHTNESS         RIGHT = RGB HUE
			bindings = <
			&bt BT_CLR      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                             &none        &none        &none        &none &none &bt BT_CLR_ALL
			&rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF &rgb_ug RGB_EFR                          &out OUT_USB &out OUT_BLE &out OUT_TOG &none &none &none
			&studio_unlock  &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_ON  &rgb_ug RGB_OFF &none                                    &none        &none        &none        &none &none &none
			&bootloader     &none           &none           &none           &none           &none  &rgb_ug RGB_TOG &ext_power EP_TOG &none        &none        &none        &none &none &sys_reset
			&trans          &trans          &trans          &trans &trans            &trans   &trans &trans       &trans       &trans
			>;
			
			sensor-bindings = <&rgb_bri_enc &rgb_hue_enc>;
		};
	};
};
